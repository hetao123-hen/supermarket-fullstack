{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build backend (mingw32-make)",
      "type": "shell",
      "command": "mingw32-make",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Clean backend (mingw32-make clean)",
      "type": "shell",
      "command": "mingw32-make clean",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "C/C++: gcc.exe 生成活动文件",
      "type": "shell",
      "command": "mingw32-make",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
